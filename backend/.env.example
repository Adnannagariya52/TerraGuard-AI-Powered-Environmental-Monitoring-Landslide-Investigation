# TerraGuard local monitor
# Copy to .env or set these environment variables before starting uvicorn.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_INTERVAL_SECONDS=30
DATABASE_PATH=./terraguard.db
SOIL_WET_PCT=70
RAIN_HIGH_PCT=65
# Optional explicit substitute while the physical rain sensor is offline.
# Fallback values are shown on the dashboard but excluded from risk scoring.
RAIN_SENSOR_OVERRIDE_PCT=
GROUND_SHIFT_WARN_CM=2.0
GROUND_SHIFT_CRITICAL_CM=5.0
GROUND_DISTANCE_CHANGE_WARN_CM=3.0

# Opt in to sending device GPS coordinates to Open-Meteo for current weather.
WEATHER_API_ENABLED=false
WEATHER_CACHE_SECONDS=600

# Comma-separated browser origins allowed to call this API. Add the deployed
# frontend's exact origin here; never use a wildcard for a public deployment.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
